# ============================================================
# 凭据 / 密钥 —— 严禁提交（泄漏防护优先）
# ============================================================
.qq_smtp.env
.env
.env.*
*.env
*.pem
*.key
*.p12
*.pfx
id_rsa
id_rsa.pub
*.secret
*token*

# ============================================================
# 大体积 / 生成产物 —— 不要提交
# ============================================================
/output/
/build/
__pycache__/
*.pyc
*.pyo
*.raw              # 原始管线产物（单个约 32MB）
out.jpeg
outrgb.raw
.DS_Store
.ds_store
*.log
*.tmp

