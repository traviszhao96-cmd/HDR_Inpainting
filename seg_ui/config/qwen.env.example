# Copy this file to qwen.env and fill in your own value.
# qwen.env is ignored by git and is only read by the local backend process.
QWEN_VISION_API_KEY=
QWEN_VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_VISION_MODEL=qwen3-vl-plus

# Optional: keep the image understanding request small and predictable.
QWEN_VISION_MAX_PIXELS=1600000
QWEN_VISION_TIMEOUT=90
